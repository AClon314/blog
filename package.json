{
	"name": "my_blog",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:md": "bun run build && bun run export:md",
		"export:md": "node scripts/export-html-to-markdown.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.18.2",
		"@mathjax/src": "^4.0.0",
		"@nvl/sveltex": "^0.5.0",
		"@sveltejs/adapter-auto": "next",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "next",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"jsdom": "^30.0.1",
		"oxfmt": "^0.61.0",
		"oxlint": "^1.76.0",
		"rehype-stringify": "^10.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.0",
		"remark-retext": "^6.0.0",
		"shiki": "^4.0.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"turndown": "^7.2.4",
		"turndown-plugin-gfm": "^1.0.2",
		"typescript": "^6.0.3",
		"unified": "^11.0.4",
		"vite": "^8.0.16"
	}
}
