{
  "name": "my_blog",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "//dev": "优先用.env而非已有的环境变量, --host则允许局域网访问本网页",
    "dev": "set -a; . .env; set +a; vite dev --host",
    "build": "vite build",
    "build:md": "bun run build && bun run export:md",
    "export:md": "node scripts/export-html-to-markdown.mjs",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.23.2",
    "@mathjax/src": "^4.1.3",
    "@nvl/sveltex": "^0.5.1",
    "@sveltejs/adapter-auto": "next",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "next",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.78.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-retext": "^6.0.1",
    "shiki": "^4.4.3",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vite": "^8.2.1"
  }
}
