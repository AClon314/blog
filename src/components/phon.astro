---
interface Props {
  children?: string;
  lang?: string;
  pairs?: string;
}

const { children = "", lang = "zh-CN", pairs = "" } = Astro.props;

function escapeHtml(value: string) {
  return value
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#39;");
}

function parsePairs(content: string) {
  const parts = content.trim().split(/\s+/).filter(Boolean);
  if (parts.length < 2 || parts.length % 2 !== 0) return null;

  const pairs: Array<[string, string]> = [];
  for (let index = 0; index < parts.length; index += 2) {
    pairs.push([parts[index], parts[index + 1]]);
  }
  return pairs;
}

function isEnglishLang(value: string) {
  return value === "en" || value.startsWith("en-");
}

const content = String(pairs || children);
const parsedPairs = parsePairs(content);
const shouldRenderPlainText =
  !!parsedPairs &&
  isEnglishLang(lang) &&
  parsedPairs.every(([base, reading]) => base === reading);

let html = "";
if (parsedPairs) {
  if (shouldRenderPlainText) {
    html = parsedPairs.map(([base]) => escapeHtml(base)).join("");
  } else {
    html = `<ruby>${parsedPairs
      .map(
        ([base, reading]) =>
          `${escapeHtml(base)}<rt>${escapeHtml(reading)}</rt>`,
      )
      .join("")}</ruby>`;
  }
}
---
{
  parsedPairs ? (
    <Fragment set:html={html} />
  ) : (
    <span>{content}</span>
  )
}
