---
import Select from '@astrojs/starlight/components/Select.astro';

const options = [
  { label: 'Auto', value: 'auto', selected: true },
  { label: 'Windows', value: 'win', selected: false },
  { label: 'macOS', value: 'mac', selected: false },
  { label: 'Linux', value: 'linux', selected: false },
  { label: 'All', value: 'all', selected: false },
];
---

<starlight-os-select>
  <Select
    icon="laptop"
    label="Operating system"
    options={options}
    width="7em"
  />
</starlight-os-select>

<script>
  import { attachOsPicker } from '/src/utils/os-runtime.ts';

  if (!customElements.get('starlight-os-select')) {
    class StarlightOsSelect extends HTMLElement {
      #detach?: () => void;

      connectedCallback() {
        const select = this.querySelector('select');
        if (select instanceof HTMLSelectElement) {
          this.#detach = attachOsPicker(select);
        }
      }

      disconnectedCallback() {
        this.#detach?.();
      }
    }

    customElements.define('starlight-os-select', StarlightOsSelect);
  }
</script>
