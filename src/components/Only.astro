---
interface Props {
  os: 'windows' | 'macos' | 'linux' | 'all' | Array<'windows' | 'macos' | 'linux' | 'all'>;
}

const values = Array.isArray(Astro.props.os) ? Astro.props.os : [Astro.props.os];
const allowed = new Set(values);
const showAll = allowed.has('all');
const attr = showAll ? 'all' : values.join(' ');
---

<starlight-only data-os={attr} data-show-all={showAll ? 'true' : 'false'}>
  <slot />
</starlight-only>

<script>
  const parseAllowed = (value) =>
    new Set(
      (value || '')
        .split(/\s+/)
        .map((item) => item.trim())
        .filter(Boolean)
    );

  const syncOnly = (root) => {
    const allowed = parseAllowed(root.dataset.os);
    const showAll = root.dataset.showAll === 'true' || allowed.has('all');
    const current = document.documentElement.dataset.os || 'all';
    root.hidden = !(showAll || allowed.has(current));
  };

  class StarlightOnly extends HTMLElement {
    connectedCallback() {
      syncOnly(this);
      window.addEventListener('starlight-os-change', this.#onChange);
    }

    disconnectedCallback() {
      window.removeEventListener('starlight-os-change', this.#onChange);
    }

    #onChange = () => {
      syncOnly(this);
    };
  }

  customElements.define('starlight-only', StarlightOnly);
</script>
